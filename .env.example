# Database (SQLite by default for local execution; or Supabase PostgreSQL)
DATABASE_URL=sqlite:///./foodloop.db

# Security & JWT
PYTHON_API_SECRET=foodloop-super-secure-production-secret-key-32bytes-min
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# API Endpoints
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Routing & Mapping
ROUTING_API_URL=https://router.project-osrm.org/route/v1/driving
GEOCODING_PROVIDER=nominatim

# Optional Supabase Integration (Leave blank to use local SQLite)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional POS Credentials
GOFRUGAL_LICENSE_KEY=
GOFRUGAL_AUTH_TOKEN=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
