*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
venv/
env/
.venv/
ENV/

# Environment Variables & Secrets (Keep .env.example only)
.env
.env.local
.env.*.local
*.env
!.env.example

# Node & Next.js
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
dist/
.turbo/
*.tsbuildinfo
frontend/next-env.d.ts

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vercel Deployment Artifacts
.vercel/
frontend/.vercel/

# Operating System & IDE Artifacts
